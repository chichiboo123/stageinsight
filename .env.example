# ============================================================
# 환경 변수 (.env)
# - VITE_ 접두사 변수는 빌드 시 클라이언트 번들에 포함됩니다(공개됨).
# - GEMINI_API_KEY는 접두사가 없어 서버(AI 게이트웨이)에서만 사용됩니다.
#   ⚠ Gemini 키에는 절대 VITE_ 접두사를 붙이지 마세요(노출 방지).
# ============================================================

# 카카오 API
VITE_KAKAO_REST_API_KEY=your_kakao_rest_api_key
VITE_KAKAO_JS_API_KEY=your_kakao_js_api_key

# KOPIS (공연예술통합전산망)
VITE_KOPIS_KEY=your_kopis_service_key

# TMDB (영화)
VITE_TMDB_KEY=your_tmdb_api_key

# 네이버 도서 API
VITE_NAVER_CLIENT_ID=your_naver_client_id
VITE_NAVER_CLIENT_SECRET=your_naver_client_secret

# Google Gemini API (서버 전용 — AI 성취기준 큐레이션 / 수업 아이디어 / 의미 보강)
# https://aistudio.google.com/app/apikey 에서 무료로 발급 (무료 티어 지원)
GEMINI_API_KEY=your_gemini_api_key
